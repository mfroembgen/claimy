{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "database", "config", "service", "migrations"],
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(:[0-9]+)?(/[A-Za-z0-9._-]+)*$"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[A-Fa-f0-9]{64})$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "required": ["host", "port", "name", "user", "existingSecret", "passwordKey", "parameters"],
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "user": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_]+$"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "passwordKey": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "parameters": {
          "type": "object",
          "required": ["loc", "time_zone", "parseTime"],
          "patternProperties": {
            "^[A-Za-z0-9_.-]+$": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "properties": {
            "loc": {
              "type": "string",
              "const": "UTC"
            },
            "time_zone": {
              "type": "string",
              "const": "'+00:00'"
            },
            "parseTime": {
              "type": "string",
              "const": "true"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "required": ["app", "httpserver", "sqlc", "claimy"],
      "properties": {
        "app": {
          "type": "object",
          "required": ["env", "project", "family", "name"],
          "properties": {
            "env": {"type": "string", "minLength": 1},
            "project": {"type": "string", "minLength": 1},
            "family": {"type": "string", "minLength": 1},
            "name": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "httpserver": {
          "type": "object",
          "additionalProperties": true
        },
        "sqlc": {
          "type": "object",
          "additionalProperties": true
        },
        "claimy": {
          "type": "object",
          "required": ["auth", "chat"],
          "properties": {
            "auth": {
              "type": "object",
              "required": ["team_domain", "rest", "gitlab", "chat", "cli"],
              "properties": {
                "team_domain": {"type": "string"},
                "rest": {
                  "type": "object",
                  "required": ["issuer", "audience", "jwks_url"],
                  "properties": {
                    "issuer": {"type": "string", "minLength": 1, "pattern": "^https://[^\\s]+$"},
                    "audience": {"type": "string"},
                    "jwks_url": {"type": "string", "minLength": 1, "pattern": "^https://[^\\s]+$"}
                  },
                  "additionalProperties": true
                },
                "gitlab": {"$ref": "#/definitions/issuerSettings"},
                "chat": {
                  "allOf": [
                    {"$ref": "#/definitions/issuerSettings"},
                    {"properties": {"issuer": {"const": "https://accounts.google.com"}}}
                  ]
                },
                "cli": {
                  "type": "object",
                  "required": ["enabled", "client_id", "scopes", "authorization_params"],
                  "properties": {
                    "enabled": {"type": "boolean"},
                    "client_id": {"type": "string"},
                    "scopes": {
                      "type": "array",
                      "items": {"type": "string"}
                    },
                    "authorization_params": {
                      "type": "object",
                      "additionalProperties": {"type": "string"}
                    }
                  },
                  "additionalProperties": true
                }
              },
              "additionalProperties": true
            },
            "chat": {
              "type": "object",
              "required": ["app_identity", "allowed_spaces", "deadline"],
              "properties": {
                "app_identity": {"type": "string"},
                "allowed_spaces": {
                  "type": "array"
                },
                "deadline": {
                  "type": "string",
                  "pattern": "^([1-9][0-9]{0,2}ms|[1-9]s|[12][0-9]s|30s)$"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "service": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "migrations": {
      "type": "object",
      "required": ["enabled", "backoffLimit", "activeDeadlineSeconds", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "configMapAnnotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "backoffLimit": {"type": "integer", "minimum": 0},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "resources": {"type": "object"}
      },
      "additionalProperties": false
    },
    "deploymentAnnotations": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "extraEnv": {
      "type": "array",
      "items": {"$ref": "#/definitions/envVar"}
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 75
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["database"],
        "properties": {
          "database": {
            "required": ["host"],
            "properties": {"host": {"const": ""}}
          }
        }
      },
      "then": {
        "required": ["extraEnv"],
        "properties": {
          "extraEnv": {
            "contains": {
              "allOf": [
                {"$ref": "#/definitions/envVar"},
                {"$ref": "#/definitions/secretSourcedEnvVar"},
                {"properties": {"name": {"const": "SQLC_DEFAULT_URI_HOST"}}, "required": ["name"]}
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "database": {
            "properties": {
              "host": {
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["config"],
        "properties": {
          "config": {
            "required": ["claimy"],
            "properties": {
              "claimy": {
                "required": ["auth"],
                "properties": {
                  "auth": {
                    "required": ["team_domain"],
                    "properties": {"team_domain": {"const": ""}}
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": ["extraEnv"],
        "properties": {
          "extraEnv": {
            "contains": {
              "allOf": [
                {"$ref": "#/definitions/envVar"},
                {"$ref": "#/definitions/secretSourcedEnvVar"},
                {"properties": {"name": {"const": "CLAIMY_AUTH_TEAM_DOMAIN"}}, "required": ["name"]}
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "config": {
            "properties": {
              "claimy": {
                "properties": {
                  "auth": {
                    "properties": {
                      "team_domain": {
                        "minLength": 1,
                        "maxLength": 253,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*[A-Za-z0-9]$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["config"],
        "properties": {
          "config": {
            "required": ["claimy"],
            "properties": {
              "claimy": {
                "required": ["auth"],
                "properties": {
                  "auth": {
                    "required": ["rest"],
                    "properties": {
                      "rest": {
                        "required": ["audience"],
                        "properties": {"audience": {"const": ""}}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": ["extraEnv"],
        "properties": {
          "extraEnv": {
            "contains": {
              "allOf": [
                {"$ref": "#/definitions/envVar"},
                {"$ref": "#/definitions/secretSourcedEnvVar"},
                {"properties": {"name": {"const": "CLAIMY_AUTH_REST_AUDIENCE"}}, "required": ["name"]}
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "config": {
            "properties": {
              "claimy": {
                "properties": {
                  "auth": {
                    "properties": {
                      "rest": {
                        "properties": {
                          "audience": {
                            "minLength": 1,
                            "maxLength": 1024,
                            "pattern": "^[^\\x00-\\x20\\x7f]+$"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["config"],
        "properties": {
          "config": {
            "required": ["claimy"],
            "properties": {
              "claimy": {
                "required": ["chat"],
                "properties": {
                  "chat": {
                    "required": ["app_identity"],
                    "properties": {"app_identity": {"const": ""}}
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": ["extraEnv"],
        "properties": {
          "extraEnv": {
            "contains": {
              "allOf": [
                {"$ref": "#/definitions/envVar"},
                {"$ref": "#/definitions/secretSourcedEnvVar"},
                {"properties": {"name": {"const": "CLAIMY_CHAT_APP_IDENTITY"}}, "required": ["name"]}
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "config": {
            "properties": {
              "claimy": {
                "properties": {
                  "chat": {
                    "properties": {"app_identity": {"minLength": 1}}
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["config"],
        "properties": {
          "config": {
            "required": ["claimy"],
            "properties": {
              "claimy": {
                "required": ["chat"],
                "properties": {
                  "chat": {
                    "required": ["allowed_spaces"],
                    "properties": {"allowed_spaces": {"maxItems": 0}}
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "required": ["extraEnv"],
        "properties": {
          "extraEnv": {
            "contains": {
              "allOf": [
                {"$ref": "#/definitions/envVar"},
                {"$ref": "#/definitions/secretSourcedEnvVar"},
                {"properties": {"name": {"const": "CLAIMY_CHAT_ALLOWED_SPACES"}}, "required": ["name"]}
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "config": {
            "properties": {
              "claimy": {
                "properties": {
                  "chat": {
                    "properties": {
                      "allowed_spaces": {
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "pattern": "^spaces/[A-Za-z0-9_-]+$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "issuerSettings": {
      "type": "object",
      "required": ["issuer", "audience", "jwks_url"],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://[^\\s]+$"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\x00-\\x20\\x7f]+$"
        },
        "jwks_url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://[^\\s]+$"
        }
      },
      "additionalProperties": true
    },
    "keySelector": {
      "type": "object",
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "requiredKeySelector": {
      "type": "object",
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "optional": {"type": "boolean", "const": false}
      },
      "additionalProperties": false
    },
    "envVar": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[-._A-Za-z][-._A-Za-z0-9]*$"
        },
        "value": {"type": "string"},
        "valueFrom": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "secretKeyRef": {"$ref": "#/definitions/keySelector"},
            "configMapKeyRef": {"$ref": "#/definitions/keySelector"},
            "fieldRef": {
              "type": "object",
              "required": ["fieldPath"],
              "properties": {
                "apiVersion": {"type": "string"},
                "fieldPath": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "resourceFieldRef": {
              "type": "object",
              "required": ["resource"],
              "properties": {
                "containerName": {"type": "string", "minLength": 1},
                "divisor": {"type": "string", "minLength": 1},
                "resource": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "not": {
        "required": ["value", "valueFrom"],
        "properties": {"value": {"minLength": 1}}
      }
    },
    "secretSourcedEnvVar": {
      "type": "object",
      "required": ["valueFrom"],
      "properties": {
        "valueFrom": {
          "type": "object",
          "anyOf": [
            {
              "required": ["secretKeyRef"],
              "properties": {"secretKeyRef": {"$ref": "#/definitions/requiredKeySelector"}}
            },
            {
              "required": ["configMapKeyRef"],
              "properties": {"configMapKeyRef": {"$ref": "#/definitions/requiredKeySelector"}}
            }
          ]
        }
      }
    }
  }
}
